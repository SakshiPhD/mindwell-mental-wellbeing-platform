# Streamlit Secrets Configuration
# Copy this to secrets.toml and fill in your actual values
# IMPORTANT: secrets.toml is NOT tracked by git - keep it local only!

# Database Credentials
[database]
host = "localhost"
port = 5432
name = "mindwell_db"
user = "postgres"
password = "your_database_password"

# LLM API Keys
[llm]
provider = "openai"  # or "anthropic", "ollama", etc
api_key = "sk-..."
model = "gpt-4"
temperature = 0.7

# Optional: For Anthropic Claude
# api_key = "sk-ant-..."
# model = "claude-3-opus"

# Optional: For Ollama (local)
# base_url = "http://localhost:11434"
# model = "llama2"

# Application Settings
[app]
debug_mode = false
session_timeout_minutes = 15
