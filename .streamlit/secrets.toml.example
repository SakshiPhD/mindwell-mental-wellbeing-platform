# Streamlit Secrets Configuration
# Copy this to secrets.toml and fill in your actual values
# IMPORTANT: secrets.toml is NOT tracked by git - keep it local only!

# Database Credentials — section name and keys must be exactly this; this is
# what database.py::_load_db_credentials actually reads (the previous
# version of this example file said [database] with a "name" key, which
# doesn't match the real code's [postgres]/"database" — fixed here).
[postgres]
host = "your-project.neon.tech"
port = 5432
database = "neondb"
user = "your_database_user"
password = "your_database_password"
sslmode = "require"

# LangSmith tracing (optional). Leave this whole section out entirely to run
# untraced — that's the default and currently the only approved mode for any
# real user data; see tracing.py's module docstring and
# MINDWELL_PROJECT_CONTEXT_AND_LLMOPS_ROADMAP.md section 11 before ever
# pointing this at real conversations instead of synthetic/test ones.
# Get a free API key at https://smith.langchain.com (Settings -> API Keys).
[langsmith]
api_key = "ls__your_key_here"
project = "mindwell"
# endpoint = "https://api.smith.langchain.com"  # default, only override for self-hosted

# Groq (optional) - automatic fallback when Ollama is unreachable, e.g. on
# Streamlit Cloud / GCP with no local Ollama. Groq serves open-weight
# models (not a proprietary GPT/Claude), hosted, with a free tier - see
# llm_provider.py::GROQ_MODELS for the exact models used. No code/env-var
# switch needed: llm_provider.py::call_llm() tries Ollama first and only
# falls back to Groq if Ollama's health check fails or it returns nothing,
# so the same code runs Ollama-only locally and Ollama-then-Groq in the
# cloud automatically. Leave this section out entirely to disable the
# fallback (Ollama-only, same as before this was added).
# Get a free API key at https://console.groq.com (API Keys).
[groq]
api_key = "gsk_your_key_here"
# base_url = "https://api.groq.com/openai/v1"  # default, only override for self-hosted

# Application Settings
[app]
debug_mode = false
session_timeout_minutes = 15
